function submitDistribution(){
  const d = state.distribution;
  if (!validateDistStep(d.step)) return;
  const data = {
    mode: d.isPro ? 'PRO' : 'STANDARD',
    artist: d.artist.trim(),
    track: d.track.trim(),
    date: d.dateISO,
    authorText: d.authorText.trim(),
    authorMusic: d.authorMusic.trim(),
    termsAgreed: true
  };
  if (!d.isPro) {
    data.email = d.email.trim();
    data.socials = d.socials.trim();
  } else {
    data.isFeat = d.isFeat;
    if (d.isFeat) data.featArtists = d.featArtists.trim();
    data.releaseType = d.releaseType;
    data.labelName = 'Pulsar Music';
    data.genre = d.genre.trim();
    data.subgenre = d.subgenre.trim();
    data.version = d.version.trim();
    data.isInstrumental = d.isInstrumental;
    data.isExplicit = d.isExplicit;
    if (!d.isInstrumental) data.vocalLang = d.vocalLang;
    data.producer = d.producer.trim();
    data.soundEngineer = d.soundEngineer.trim();
    data.pitching = d.pitching.trim();
    data.lyrics = d.lyrics.trim();
    data.socials = d.socialRows.filter(r => r.url.trim());
  }
  if (window.Telegram && window.Telegram.WebApp && typeof window.Telegram.WebApp.sendData === 'function') {
    try {
      window.Telegram.WebApp.sendData(JSON.stringify(data));
      window.Telegram.WebApp.close();
      return;
    } catch(e) { console.warn('sendData fail', e); }
  }
  console.log('Distribution data:', data);
  d.submitted = true;
  d.submittedData = data;
  render();
  confettiBurst();
}

