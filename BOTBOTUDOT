function getStatus(id){ const p = progress[id]; if (!p) return 'none'; if (typeof p === 'boolean') return p ? 'done' : 'none'; if (p.quiz) return 'done'; if (p.read) return 'read'; return 'none'; }
function markRead(id){ if (!progress[id]) progress[id] = { read:true, quiz:false }; else progress[id].read = true; saveProgress(); }
