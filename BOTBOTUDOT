<script>
(function(){
  function showErrorBox(prefix, text){
    try {
      var box = document.createElement('pre');
      box.style.cssText = 'position:fixed;inset:0;z-index:2147483647;background:#000;color:#ff5555;padding:16px;font-family:ui-monospace,Menlo,monospace;font-size:11px;line-height:1.4;white-space:pre-wrap;word-break:break-all;margin:0;overflow:auto;-webkit-overflow-scrolling:touch';
      box.textContent = prefix + '\n\n' + text + '\n\n---\nСкопируй этот текст и пришли разработчику';
      document.body.appendChild(box);
    } catch(e) {}
  }
  window.addEventListener('error', function(e){
    var file = (e.filename||'').split('/').pop() || 'inline';
    showErrorBox('JS ERROR',
      (e.message||'unknown') + '\n\nФайл: ' + file + '\nСтрока: ' + (e.lineno||'?') + ':' + (e.colno||'?') +
      (e.error && e.error.stack ? '\n\n' + e.error.stack : '')
    );
  });
  window.addEventListener('unhandledrejection', function(e){
    var r = e.reason;
    showErrorBox('PROMISE REJECTION', (r && (r.stack || r.message)) || String(r));
  });
})();
</script>

