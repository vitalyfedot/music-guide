.fb-thanks{text-align:center;padding:14px;color:var(--cyan);font-weight:600;font-size:13px}
.search-bar{width:100%;padding:14px 16px;background:var(--card);border:1px solid var(--border);border-radius:12px;color:var(--text);font-size:14px;font-family:inherit;margin-bottom:16px;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.search-bar:focus{outline:none;border-color:var(--cyan);box-shadow:0 0 20px var(--cyan-glow)}
.search-bar::placeholder{color:var(--dim2)}
.glossary-item{padding:14px 16px;background:var(--card);border:1px solid var(--border);border-radius:12px;margin-bottom:8px;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);position:relative;padding-left:18px}
