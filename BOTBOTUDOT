.mist-item:last-child{border-bottom:none}
.mist-item strong{color:var(--cyan);display:block;margin-bottom:4px;font-size:12.5px;font-weight:600}
.placeholder-card{text-align:center;padding:52px 24px;background:var(--card);border:1px solid var(--border-strong);border-radius:var(--r);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.placeholder-card .emo{font-size:52px;display:block;margin-bottom:18px;filter:drop-shadow(0 0 20px var(--cyan-glow))}
.placeholder-card h2{font-size:16px;margin-bottom:12px;letter-spacing:2px;text-transform:uppercase;color:var(--cyan)}
.placeholder-card p{color:var(--dim);font-size:13px;line-height:1.65}
.goal-pick{padding:16px;background:var(--card);border:1px solid var(--border);border-radius:14px;margin-bottom:8px;cursor:pointer;display:flex;align-items:center;gap:14px;transition:.3s;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.goal-pick:hover{border-color:var(--cyan);transform:translateX(3px)}
.goal-pick.selected{border-color:var(--cyan);background:rgba(6,182,212,.1);box-shadow:0 0 20px var(--cyan-glow)}
.goal-pick .gi{font-size:24px}
.goal-pick .gt{font-size:13.5px;font-weight:600}
.reset-btn{width:100%;padding:14px;border:1px solid rgba(239,68,68,.25);color:var(--err);border-radius:12px;font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;transition:.2s;margin-top:14px;letter-spacing:1.5px;text-transform:uppercase;background:rgba(239,68,68,.03)}
.reset-btn:hover{background:rgba(239,68,68,.1);border-color:var(--err)}
.brand{text-align:center;margin-top:30px;font-size:10px;color:var(--dim2);letter-spacing:3px;text-transform:uppercase}
.brand strong{color:var(--cyan);letter-spacing:4px;font-weight:800}
.confetti{position:fixed;top:-10px;width:8px;height:8px;z-index:999;pointer-events:none;animation:fall linear forwards}
@keyframes fall{to{transform:translateY(100vh) rotate(720deg);opacity:0}}
.reading-bar{position:fixed;top:0;left:0;right:0;height:2px;background:transparent;z-index:100;display:none}
.reading-bar.show{display:block}
.reading-fill{height:100%;background:linear-gradient(90deg,var(--cyan),var(--blue));width:0;transition:width .1s;box-shadow:0 0 10px var(--cyan)}
.term-sheet{position:fixed;inset:0;z-index:1000;display:none;align-items:flex-end}
.term-sheet.show{display:flex}
.sheet-overlay{position:absolute;inset:0;background:rgba(0,0,0,.75);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px)}
.sheet-content{position:relative;width:100%;max-width:480px;margin:0 auto;background:#0a0a0a;border-radius:20px 20px 0 0;padding:24px 20px 32px;animation:sheetUp .3s ease;border-top:1px solid var(--cyan);box-shadow:0 -10px 40px var(--cyan-glow)}
.sheet-term{font-size:18px;font-weight:800;color:var(--cyan);margin-bottom:12px;letter-spacing:1px;text-transform:uppercase}
.sheet-def{font-size:14px;line-height:1.7;color:var(--text);margin-bottom:22px}
.sheet-close{width:100%;padding:15px;background:linear-gradient(135deg,var(--cyan),var(--blue));color:#000;border:none;border-radius:12px;font-size:13px;font-weight:800;cursor:pointer;font-family:inherit;letter-spacing:1.5px;text-transform:uppercase}
@keyframes sheetUp{from{transform:translateY(100%)}to{transform:translateY(0)}}
.graduation{text-align:center;padding:32px 20px;background:linear-gradient(135deg,rgba(6,182,212,.15),rgba(59,130,246,.12));border:1px solid var(--border-strong);border-radius:var(--r);margin-bottom:16px;position:relative;overflow:hidden}
.graduation.middle{background:linear-gradient(135deg,rgba(16,185,129,.15),rgba(6,182,212,.1));border-color:rgba(16,185,129,.35)}
.graduation.pro{background:linear-gradient(135deg,rgba(139,92,246,.15),rgba(59,130,246,.1));border-color:rgba(139,92,246,.35)}
.graduation .trophy{font-size:72px;display:block;margin-bottom:16px;filter:drop-shadow(0 0 30px var(--cyan-glow))}
.graduation h2{font-size:22px;font-weight:800;letter-spacing:3px;text-transform:uppercase;color:var(--cyan);margin-bottom:10px}
.graduation.middle h2{color:var(--green)}
.graduation.pro h2{color:var(--violet)}
.graduation p{color:rgba(255,255,255,.75);font-size:13.5px;line-height:1.6}
.stats-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-bottom:16px}
.stat-box{padding:16px 14px;background:var(--card);border:1px solid var(--border);border-radius:12px;text-align:center;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.stat-box .sv{font-size:22px;font-weight:800;color:var(--cyan);margin-bottom:4px;text-shadow:0 0 20px var(--cyan-glow)}
.stat-box .sl{font-size:10px;text-transform:uppercase;letter-spacing:1.5px;color:var(--dim)}
.funnel-title{text-align:center;font-size:11px;text-transform:uppercase;letter-spacing:3px;color:var(--cyan);font-weight:700;margin:24px 0 14px}
.funnel-card{display:flex;align-items:center;gap:14px;padding:16px 18px;background:var(--card);border:1px solid var(--border);border-radius:14px;margin-bottom:10px;cursor:pointer;transition:.3s;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.funnel-card:hover{border-color:var(--cyan);transform:translateY(-2px);box-shadow:0 8px 30px var(--cyan-glow)}
.funnel-card.main{border-color:var(--border-strong);background:linear-gradient(135deg,rgba(6,182,212,.1),rgba(59,130,246,.06))}
.funnel-card .fi{font-size:26px;width:48px;height:48px;display:flex;align-items:center;justify-content:center;background:rgba(6,182,212,.1);border:1px solid rgba(6,182,212,.25);border-radius:12px;flex-shrink:0}
.funnel-card .ft{flex:1}
.funnel-card .fn{font-size:14px;font-weight:700;margin-bottom:3px}
.funnel-card .fd{font-size:11.5px;color:var(--dim);line-height:1.5}
.funnel-card .fa{font-size:18px;color:var(--cyan)}
.streak-toast{position:fixed;top:20px;left:50%;transform:translateX(-50%) translateY(-100px);padding:14px 22px;background:#0a0a0a;border:1px solid var(--warn);border-radius:14px;color:var(--warn);font-size:13px;font-weight:600;z-index:2000;transition:transform .4s ease;box-shadow:0 10px 40px rgba(245,158,11,.3);max-width:calc(100vw - 40px);text-align:center}
.streak-toast.show{transform:translateX(-50%) translateY(0)}
.test-intro-card{padding:20px;background:var(--card);border:1px solid var(--border);border-radius:14px;margin-bottom:12px;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.test-intro-card h3{font-size:15px;font-weight:700;margin-bottom:10px}
.test-intro-card p{font-size:13px;line-height:1.6;color:rgba(255,255,255,.85);margin-bottom:8px}
.test-intro-card .stat-row{display:flex;justify-content:space-between;padding:6px 0;font-size:12.5px;color:rgba(255,255,255,.75)}
.test-intro-card .stat-row b{color:var(--cyan)}
.discount-card{text-align:center;padding:32px 24px;background:linear-gradient(135deg,rgba(6,182,212,.12),rgba(59,130,246,.08));border:1px solid var(--border-strong);border-radius:var(--r);margin-bottom:16px;position:relative;overflow:hidden}
.discount-card::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 50% 0%,rgba(6,182,212,.2),transparent 60%);pointer-events:none}
.discount-label{font-size:11px;text-transform:uppercase;letter-spacing:2px;color:var(--cyan);font-weight:700;margin-bottom:14px;position:relative}
.discount-amount{font-size:64px;font-weight:800;color:var(--cyan);text-shadow:0 0 40px var(--cyan-glow);letter-spacing:-2px;line-height:1;margin-bottom:14px;position:relative}
.discount-note{font-size:13px;color:rgba(255,255,255,.75);line-height:1.55;position:relative}
.discount-badge{display:inline-block;padding:8px 18px;background:linear-gradient(135deg,var(--cyan),var(--blue));color:#000;border-radius:10px;font-weight:800;font-size:15px;letter-spacing:1px;margin-top:12px;position:relative}

/* ===== DISTRIBUTION ===== */
.dist-splash{text-align:center;padding:44px 24px;margin-bottom:18px;background:linear-gradient(135deg,rgba(6,182,212,.1),rgba(59,130,246,.06));border:1px solid var(--border-strong);border-radius:var(--r);position:relative;overflow:hidden}
.dist-splash::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 50% 0%,rgba(6,182,212,.2),transparent 60%);pointer-events:none}
.dist-splash-title{font-size:40px;font-weight:900;letter-spacing:3px;line-height:1.1;margin-bottom:18px;position:relative;
  background-image:linear-gradient(90deg,#fff 0%,var(--cyan) 30%,var(--blue) 50%,var(--cyan) 70%,#fff 100%);
  background-size:200% auto;-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;
  animation:shine 3s linear infinite;filter:drop-shadow(0 0 20px var(--cyan-glow))}
@keyframes shine{to{background-position:200% center}}
.dist-splash-sub{color:var(--dim);font-size:14px;line-height:1.6;position:relative}
.dist-modes{display:flex;align-items:center;justify-content:center;gap:14px;padding:10px;background:var(--card);border:1px solid var(--border);border-radius:14px;margin-bottom:14px;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.dist-modes span{font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;color:var(--dim);cursor:pointer;transition:color .3s}
.dist-modes span.active{color:var(--text)}
.dist-toggle{width:48px;height:24px;background:rgba(255,255,255,.06);border:1px solid var(--border);border-radius:15px;position:relative;cursor:pointer;transition:.3s;flex-shrink:0}
.dist-toggle.on{background:rgba(249,115,22,.2);border-color:#f97316}
.dist-toggle-knob{position:absolute;top:2px;left:2px;width:18px;height:18px;background:var(--cyan);border-radius:50%;transition:.3s;box-shadow:0 0 8px var(--cyan-glow)}
.dist-toggle.on .dist-toggle-knob{transform:translateX(23px);background:#f97316;box-shadow:0 0 8px rgba(249,115,22,.5)}
.dist-progress{display:flex;justify-content:center;gap:8px;margin-bottom:18px;flex-wrap:wrap}
.dist-dot{width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;background:rgba(255,255,255,.04);border:1px solid var(--border);color:var(--dim);cursor:pointer;transition:.3s}
.dist-dot.active{color:var(--cyan);border-color:var(--cyan);background:rgba(6,182,212,.08);box-shadow:0 0 10px var(--cyan-glow)}
.dist-dot.complete{color:var(--success);border-color:var(--success);background:rgba(16,185,129,.06)}
.dist-dot.complete.active{box-shadow:0 0 14px rgba(16,185,129,.5)}
.dist-legend{display:flex;justify-content:center;gap:14px;font-size:10.5px;margin-top:-6px;margin-bottom:8px;color:var(--dim);letter-spacing:.5px;flex-wrap:wrap}
.dist-legend span{display:flex;align-items:center;gap:4px}
.dist-dot-legend{display:inline-block;width:7px;height:7px;border-radius:50%;box-shadow:0 0 5px currentColor}
.dist-switch{position:relative;display:inline-block;width:42px;height:22px;flex-shrink:0}
.dist-switch input{opacity:0;width:0;height:0}
.dist-slider{position:absolute;cursor:pointer;inset:0;background:rgba(255,255,255,.08);border:1px solid var(--border);border-radius:22px;transition:.3s}
.dist-slider:before{position:absolute;content:"";height:14px;width:14px;left:3px;bottom:2px;background:#fff;border-radius:50%;transition:.3s}
.dist-switch input:checked + .dist-slider{background:var(--cyan);border-color:var(--cyan);box-shadow:0 0 10px var(--cyan-glow)}
.dist-switch input:checked + .dist-slider:before{transform:translateX(20px);background:#000}
.dist-switch-label{display:flex;justify-content:space-between;align-items:center;gap:10px;font-size:13px;color:rgba(255,255,255,.9);cursor:pointer}
.dist-social-row{display:flex;gap:6px;align-items:center;margin-bottom:8px}
.dist-social-row select{width:100px;flex-shrink:0;padding:12px 6px;font-size:12px;text-align:left;margin-bottom:0}
.dist-social-row input{flex:1;margin-bottom:0;padding:12px;font-size:13px;text-align:left}
.dist-remove-btn{width:36px;height:36px;border-radius:8px;background:rgba(239,68,68,.1);border:1px solid rgba(239,68,68,.3);color:var(--err);font-size:18px;cursor:pointer;flex-shrink:0;display:flex;align-items:center;justify-content:center;font-family:inherit}
