.fb-btns{display:flex;gap:10px;justify-content:center;margin-bottom:14px}
.fb-btn{width:64px;height:56px;background:rgba(255,255,255,.04);border:1px solid var(--border);border-radius:12px;font-size:24px;cursor:pointer;transition:.2s}
