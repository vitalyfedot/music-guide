.fb-textarea{width:100%;padding:12px 14px;background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:10px;color:var(--text);font-size:13px;font-family:inherit;resize:none;min-height:64px;margin-bottom:10px;line-height:1.5}
