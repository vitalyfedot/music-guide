function plural(n, f){ n = Math.abs(n); const l = n % 10, l2 = n % 100; if (l2 >= 11 && l2 <= 14) return f[2]; if (l === 1) return f[0]; if (l >= 2 && l <= 4) return f[1]; return f[2]; }
