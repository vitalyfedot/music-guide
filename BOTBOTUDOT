function validateDistStep(step){
  const d = state.distribution;
  if (step === 1) {
    if (!d.artist.trim() || !d.track.trim()) { showDistToast('Заполните имя артиста и название трека'); return false; }
    if (!d.dateStr) { showDistToast('Выберите дату релиза'); return false; }
    if (d.dateStatus !== 'green') { showDistToast('Дата релиза должна быть минимум через 21 день'); return false; }
    if (!d.isPro) {
      if (!isValidEmail(d.email)) { showDistToast('Введите корректный Email (name@yandex.ru)'); return false; }
    } else {
      if (!d.releaseType) { showDistToast('Выберите тип релиза'); return false; }
      if (!d.genre.trim()) { showDistToast('Укажите жанр'); return false; }
      if (!d.isInstrumental && !d.vocalLang) { showDistToast('Выберите язык вокала или отметьте Инструментал'); return false; }
      if (d.isFeat && !d.featArtists.trim()) { showDistToast('Укажите приглашённых артистов'); return false; }
    }
    return true;
  }
  if (step === 2) {
    if (!d.authorText.trim() || !d.authorMusic.trim()) { showDistToast('Заполните данные об авторах'); return false; }
    if (!d.isPro) {
      if (!isValidUrl(d.socials)) { showDistToast('Добавьте корректную ссылку на соцсети'); return false; }
      if (!d.rightsText || !d.rightsMusic || !d.agreeDist) { showDistToast('Подтвердите все три пункта'); return false; }
    } else {
      if (!d.producer.trim() || !d.soundEngineer.trim()) { showDistToast('Заполните продюсера и звукорежиссёра'); return false; }
    }
    return true;
  }
  if (step === 3) {
    if (!d.socialRows.length) { showDistToast('Добавьте хотя бы одну ссылку'); return false; }
    if (!d.socialRows.every(r => isValidUrl(r.url))) { showDistToast('Заполните все ссылки корректно'); return false; }
    return true;
  }
  if (step === 4) {
    if (!d.pitching.trim()) { showDistToast('Заполните поле Питчинг'); return false; }
    if (!d.rightsText || !d.rightsMusic || !d.agreeDist) { showDistToast('Подтвердите все три пункта'); return false; }
    return true;
  }
  return true;
}

let flatpickrLocalized = false;
function initDistDatePicker(){
  try {
    const input = document.getElementById('distDatePicker');
    if (!input || typeof flatpickr === 'undefined') return;
    if (input._flatpickr) { try { input._flatpickr.destroy(); } catch(e){} }
    if (!flatpickrLocalized && flatpickr.l10ns && flatpickr.l10ns.ru) { flatpickr.localize(flatpickr.l10ns.ru); flatpickrLocalized = true; }
    flatpickr(input, {
      minDate: "today",
      dateFormat: "d.m.Y",
      disableMobile: true,
      defaultDate: state.distribution.dateStr || null,
      onDayCreate: function(dObj, dStr, fp, dayElem){
        const today = new Date(); today.setHours(0,0,0,0);
        const dayDate = new Date(dayElem.dateObj); dayDate.setHours(0,0,0,0);
        const diff = Math.ceil((dayDate - today) / (1000*60*60*24));
        if (diff >= 0 && diff < 17) dayElem.classList.add('date-red');
        else if (diff >= 17 && diff < 21) dayElem.classList.add('date-yellow');
        else if (diff >= 21) dayElem.classList.add('date-green');
      },
      onChange: function(selectedDates, dateStr){
        if (!selectedDates[0]) return;
        const d = state.distribution;
        d.dateStr = dateStr;
        d.dateISO = formatISODate(selectedDates[0]);
        const today = new Date(); today.setHours(0,0,0,0);
        const diff = Math.ceil((selectedDates[0] - today) / (1000*60*60*24));
        input.classList.remove('date-red','date-yellow','date-green');
        if (diff < 17) { input.classList.add('date-red'); d.dateStatus = 'red'; }
        else if (diff < 21) { input.classList.add('date-yellow'); d.dateStatus = 'yellow'; }
        else { input.classList.add('date-green'); d.dateStatus = 'green'; }
        updateDistUI();
      }
    });
  } catch(e) { console.warn('flatpickr fail', e); }
}

function bindDistribution(){
  document.querySelectorAll('[data-dist-back]').forEach(el => el.addEventListener('click', () => {
    state.view = 'home';
    render();
  }));
  document.querySelectorAll('[data-dist-start]').forEach(el => el.addEventListener('click', () => {
    state.distribution.step = 1;
    render();
  }));
  document.querySelectorAll('[data-dist-toggle]').forEach(el => el.addEventListener('click', () => {
    const d = state.distribution;
    d.isPro = !d.isPro;
    const totalSteps = d.isPro ? 4 : 2;
    if (d.step > totalSteps) d.step = totalSteps;
    render();
  }));
  document.querySelectorAll('[data-dist-mode]').forEach(el => el.addEventListener('click', () => {
    const d = state.distribution;
    const wantPro = el.dataset.distMode === 'pro';
    if (d.isPro === wantPro) return;
    d.isPro = wantPro;
    const totalSteps = d.isPro ? 4 : 2;
    if (d.step > totalSteps) d.step = totalSteps;
    render();
  }));
  document.querySelectorAll('[data-dist-step]').forEach(el => el.addEventListener('click', () => {
    const target = parseInt(el.dataset.distStep);
    const current = state.distribution.step;
    if (target === current) return;
    if (target < current) {
      state.distribution.step = target;
      render();
    } else {
      for (let s = current; s < target; s++) {
        if (!validateDistStep(s)) return;
      }
      state.distribution.step = target;
      render();
    }
  }));
  document.querySelectorAll('[data-dist-next]').forEach(el => el.addEventListener('click', () => {
    if (validateDistStep(state.distribution.step)) {
      state.distribution.step++;
      render();
    }
  }));
  document.querySelectorAll('[data-dist-prev]').forEach(el => el.addEventListener('click', () => {
    if (state.distribution.step > 1) state.distribution.step--;
    else state.distribution.step = 0;
    render();
  }));
  document.querySelectorAll('[data-dist-submit]').forEach(el => el.addEventListener('click', () => {
    submitDistribution();
  }));
  document.querySelectorAll('[data-dist-field]').forEach(el => {
    const field = el.dataset.distField;
    const shouldRerender = ['isFeat','isInstrumental'].includes(field);
    const update = () => {
      if (el.type === 'checkbox') state.distribution[field] = el.checked;
      else state.distribution[field] = el.value;
    };
    if (el.type === 'checkbox') {
      el.addEventListener('change', () => { update(); if (shouldRerender) render(); else updateDistUI(); });
    } else {
      el.addEventListener('input', () => { update(); updateDistUI(); });
      el.addEventListener('change', () => { update(); updateDistUI(); });
    }
  });
  document.querySelectorAll('[data-social-url]').forEach(el => {
    el.addEventListener('input', () => {
      const i = parseInt(el.dataset.socialUrl);
      if (state.distribution.socialRows[i]) {
        state.distribution.socialRows[i].url = el.value;
        updateDistUI();
      }
    });
  });
  document.querySelectorAll('[data-social-type]').forEach(el => {
    el.addEventListener('change', () => {
      const i = parseInt(el.dataset.socialType);
      if (state.distribution.socialRows[i]) state.distribution.socialRows[i].type = el.value;
    });
  });
  document.querySelectorAll('[data-dist-add-social]').forEach(el => el.addEventListener('click', () => {
    state.distribution.socialRows.push({type:'VK', url:''});
    render();
  }));
  document.querySelectorAll('[data-dist-remove-social]').forEach(el => el.addEventListener('click', () => {
    const i = parseInt(el.dataset.distRemoveSocial);
    if (state.distribution.socialRows.length > 1) {
      state.distribution.socialRows.splice(i, 1);
      render();
    }
  }));
  document.querySelectorAll('[data-dist-reset]').forEach(el => el.addEventListener('click', () => {
    resetDistributionForm();
    render();
  }));
  document.querySelectorAll('[data-show-terms]').forEach(el => el.addEventListener('click', e => {
    e.preventDefault();
    document.getElementById('distTermsModal').classList.add('show');
  }));
  if (state.distribution.step === 1) initDistDatePicker();
}

