    render();
  }));
  document.querySelectorAll('[data-level]').forEach(el => el.addEventListener('click', () => {
    state.level = el.dataset.level; state.view = 'lessons';
    state.simChosen = null; state.simShowAll = false; state.simTried = {};
    render();
  }));
  document.querySelectorAll('[data-lesson]').forEach(el => el.addEventListener('click', () => {
    state.lesson = parseInt(el.dataset.lesson); state.quizIdx = 0; state.fbSelected = null; state.view = 'lesson'; render();
  }));
  document.querySelectorAll('[data-goto-lesson]').forEach(el => el.addEventListener('click', () => {
    state.lesson = parseInt(el.dataset.gotoLesson); state.quizIdx = 0; state.fbSelected = null; state.view = 'lesson'; render();
  }));
  document.querySelectorAll('[data-goto-level]').forEach(el => el.addEventListener('click', () => {
    state.level = el.dataset.gotoLevel; state.view = 'lessons'; render();
  }));
  document.querySelectorAll('[data-prev]').forEach(el => el.addEventListener('click', () => { state.lesson = Math.max(0, state.lesson-1); state.quizIdx = 0; render(); }));
  document.querySelectorAll('[data-next]').forEach(el => el.addEventListener('click', () => {
    const l = LESSONS[state.lesson]; markRead(l.id);
    if (l.quiz && l.quiz.length) { state.quizIdx = 0; state.view = 'quiz'; render(); }
    else { markQuizDone(l.id); state.view = 'complete'; render(); confettiBurst(); }
  }));
  document.querySelectorAll('[data-open]').forEach(el => el.addEventListener('click', () => {
    if (el.dataset.open === 'funnel_release') {
      state.distribution.from = state.view;
    }
    state.view = el.dataset.open;
    render();
  }));
  document.querySelectorAll('[data-start-test]').forEach(el => el.addEventListener('click', () => {
    state.testIdx = 0; state.testAnswers = []; state.view = 'test'; render();
  }));
  document.querySelectorAll('[data-collapse]').forEach(el => {
    const header = el.querySelector('.collapse-header');
    if (header) header.addEventListener('click', () => {
      const key = el.dataset.collapse;
      toggleCollapse(key);
      el.classList.toggle('open', !!collapseState[key]);
    });
  });
  document.querySelectorAll('.option-btn[data-opt]').forEach(btn => btn.addEventListener('click', () => {
    const ans = document.getElementById('optAnswer'); if (!ans) return;
    ans.textContent = btn.dataset.opt === 'self' ? 'Отлично! Значит, ты сам создаёшь музыку — это профессиональный уровень.' : 'Тогда важно разобраться в правах на бит — читай дальше, это ключевое.';
    ans.classList.add('show');
  }));
  document.querySelectorAll('.expandable-head').forEach(h => h.addEventListener('click', () => h.parentElement.classList.toggle('open')));
  document.querySelectorAll('.quiz-opt[data-qi]').forEach(btn => btn.addEventListener('click', () => handleQuizAnswer(parseInt(btn.dataset.qi))));
  document.querySelectorAll('.quiz-opt[data-tqi]').forEach(btn => btn.addEventListener('click', () => handleTestAnswer(parseInt(btn.dataset.tqi))));
  document.querySelectorAll('.fb-btn').forEach(btn => btn.addEventListener('click', () => {
    state.fbSelected = btn.dataset.fb;
    document.querySelectorAll('.fb-btn').forEach(b => b.classList.toggle('active', b === btn));
    const send = document.getElementById('fbSend'); if (send) send.disabled = false;
  }));
  const fbSend = document.getElementById('fbSend');
  if (fbSend) fbSend.addEventListener('click', () => {
    const l = LESSONS[state.lesson];
    const txt = (document.getElementById('fbText')?.value || '').trim();
    feedbackStore[l.id] = {rating: state.fbSelected, text: txt, ts: Date.now()};
    saveFeedback(); state.view = 'complete'; render();
  });
  const gs = document.getElementById('glossarySearch');
  if (gs) gs.addEventListener('input', e => { document.getElementById('glossaryList').innerHTML = renderGlossaryItems(e.target.value); });
  ['calcStreams','calcPlatform','calcCommission'].forEach(id => { const el = document.getElementById(id); if (el) el.addEventListener('input', doCalc); });
  document.querySelectorAll('[data-sim]').forEach(el => el.addEventListener('click', () => {
    state.simChosen = el.dataset.sim; state.simTried[el.dataset.sim] = true; render();
  }));
  document.querySelectorAll('[data-sim-reset]').forEach(el => el.addEventListener('click', () => { state.simChosen = null; render(); }));
  document.querySelectorAll('[data-sim-all]').forEach(el => el.addEventListener('click', () => { state.simShowAll = !state.simShowAll; render(); }));
  document.querySelectorAll('[data-check]').forEach(label => {
    const cb = label.querySelector('input');
    cb.addEventListener('change', e => {
      e.stopPropagation();
      safeSet(label.dataset.check, cb.checked ? '1' : '0');
      label.classList.toggle('done', cb.checked);
    });
    label.addEventListener('click', e => {
      if (e.target.tagName !== 'INPUT') { e.preventDefault(); cb.checked = !cb.checked; cb.dispatchEvent(new Event('change', {bubbles:true})); }
    });
  });
  document.querySelectorAll('[data-inline-check]').forEach(label => {
    const cb = label.querySelector('input');
    cb.addEventListener('change', e => {
      e.stopPropagation();
      safeSet(label.dataset.inlineCheck, cb.checked ? '1' : '0');
      label.classList.toggle('done', cb.checked);
    });
    label.addEventListener('click', e => {
      if (e.target.tagName !== 'INPUT') { e.preventDefault(); cb.checked = !cb.checked; cb.dispatchEvent(new Event('change', {bubbles:true})); }
    });
  });
  document.querySelectorAll('[data-goal]').forEach(el => el.addEventListener('click', () => { saveGoal(el.dataset.goal); state.view = 'home'; render(); }));
  const cr = document.getElementById('confirmReset');
  if (cr) cr.addEventListener('click', () => { resetProgress(); state.view = 'home'; render(); });
  const rf = document.querySelector('.rank-card .rf');
  if (rf) { const w = rf.style.width; rf.style.width = '0%'; requestAnimationFrame(() => setTimeout(() => rf.style.width = w, 120)); }
  if (state.view === 'funnel_release') bindDistribution();
}

document.addEventListener('click', e => {
  if (e.target.closest('[data-close-terms]') || e.target.classList.contains('dist-modal-overlay')) {
    const m = document.getElementById('distTermsModal');
    if (m) m.classList.remove('show');
  }
});

document.addEventListener('keydown', e => {
  if (state.view !== 'funnel_release') return;
  if (e.key !== 'Enter') return;
  if (e.target.tagName === 'TEXTAREA') return;
  if (state.distribution.step === 0) return;
  const nextBtn = document.querySelector('[data-dist-next]');
  const submitBtn = document.querySelector('[data-dist-submit]');
  if (nextBtn) { e.preventDefault(); nextBtn.click(); }
  else if (submitBtn) { e.preventDefault(); submitBtn.click(); }
});

function handleQuizAnswer(optIdx){
  const l = LESSONS[state.lesson];
  const q = l.quiz[state.quizIdx];
  const btns = document.querySelectorAll('.quiz-opt');
  const hint = document.getElementById('quizHint');
  btns.forEach(b => b.classList.remove('correct','wrong'));
  if (optIdx === q.correct) {
    btns[optIdx].classList.add('correct');
    btns.forEach(b => b.classList.add('disabled'));
    if (hint) { hint.className = 'quiz-hint success show'; hint.innerHTML = `<strong>Верно! 🎯</strong>${q.whyCorrect || ''}`; }
    setTimeout(() => {
      if (state.quizIdx + 1 < l.quiz.length) { state.quizIdx++; render(); }
      else { markQuizDone(l.id); state.fbSelected = null; state.view = 'complete'; render(); confettiBurst(); }
    }, 1400);
  } else {
    btns[optIdx].classList.add('wrong');
    if (hint) {
      hint.className = 'quiz-hint error show';
      const why = q.opts[optIdx].why || 'Это не совсем верно. Попробуй другой вариант.';
      hint.innerHTML = `<strong>Не совсем 💭</strong>${why}<br><br><em>Попробуй ещё раз — выбери другой вариант.</em>`;
    }
    setTimeout(() => { btns[optIdx].classList.remove('wrong'); }, 1200);
  }
}

function handleTestAnswer(optIdx){
  const q = TEST_QUESTIONS[state.testIdx];
  const btns = document.querySelectorAll('.quiz-opt[data-tqi]');
  const hint = document.getElementById('quizHint');
  btns.forEach(b => b.classList.remove('correct','wrong'));
  if (optIdx === q.correct) {
    btns[optIdx].classList.add('correct');
    btns.forEach(b => b.classList.add('disabled'));
    if (hint) { hint.className = 'quiz-hint success show'; hint.innerHTML = `<strong>Верно! 🎯</strong>${q.whyCorrect || ''}`; }
    state.testAnswers.push({ q: q.q, chosen: optIdx, correct: q.correct, ok: true });
    setTimeout(() => {
      if (state.testIdx + 1 < TEST_QUESTIONS.length) { state.testIdx++; render(); }
      else finishTest();
    }, 1200);
  } else {
    btns[optIdx].classList.add('wrong');
    btns[q.correct].classList.add('correct');
    btns.forEach(b => b.classList.add('disabled'));
    if (hint) {
      hint.className = 'quiz-hint error show';
      const why = q.opts[optIdx].why || 'Это не совсем верно.';
      hint.innerHTML = `<strong>Не совсем 💭</strong>${why}<br><br><em style="opacity:.8">Правильный ответ выделен зелёным.</em>`;
    }
    state.testAnswers.push({ q: q.q, chosen: optIdx, correct: q.correct, ok: false });
    setTimeout(() => {
      if (state.testIdx + 1 < TEST_QUESTIONS.length) { state.testIdx++; render(); }
      else finishTest();
    }, 2200);
  }
}

function finishTest(){
  const score = state.testAnswers.filter(a => a.ok).length;
  const total = TEST_QUESTIONS.length;
  saveTest({ score, total, ts: Date.now(), answers: state.testAnswers });
  state.view = 'test_result';
  render();
  if (score / total >= 0.5) confettiBurst();
}

function doCalc(){
  const streams = parseInt(document.getElementById('calcStreams')?.value) || 0;
  const platform = document.getElementById('calcPlatform')?.value;
  const commission = Math.max(0, Math.min(100, parseFloat(document.getElementById('calcCommission')?.value) || 0));
  const rate = PLATFORM_RATES[platform]?.rate || 0;
  const grossMonth = streams * rate;
  const netMonth = grossMonth * (1 - commission/100);
  const $ = id => document.getElementById(id);
  if ($('calcGrossMonth')) $('calcGrossMonth').textContent = formatMoney(grossMonth);
  if ($('calcGrossYear')) $('calcGrossYear').textContent = formatMoney(grossMonth * 12);
  if ($('calcNetMonth')) $('calcNetMonth').textContent = formatMoney(netMonth);
  if ($('calcNetYear')) $('calcNetYear').textContent = formatMoney(netMonth * 12);
  if ($('calcNetHdr')) $('calcNetHdr').textContent = `После комиссии ${commission}% (на руки)`;
}

function confettiBurst(){
  const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
  if (isIOS) return;
  const colors = ['#06b6d4','#3b82f6','#22d3ee','#60a5fa','#ffffff'];
  for (let i = 0; i < 55; i++) {
    const c = document.createElement('div');
    c.className = 'confetti';
    c.style.left = Math.random()*100 + 'vw';
    c.style.background = colors[Math.floor(Math.random()*colors.length)];
    c.style.animationDuration = (1.5 + Math.random()*1.5) + 's';
    c.style.animationDelay = (Math.random()*0.4) + 's';
    c.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
    c.style.boxShadow = '0 0 8px currentColor';
    document.body.appendChild(c);
    setTimeout(() => c.remove(), 4000);
  }
}

try {
  render();
} catch(e) {
  const app = document.getElementById('app');
  if (app) app.innerHTML = '<pre style="color:#f66;padding:20px;font-family:ui-monospace,monospace;font-size:12px;white-space:pre-wrap;word-break:break-all">Ошибка запуска:\n' + (e.message||e) + '\n\n' + (e.stack||'') + '</pre>';
}
</script>
