function getLevelLessons(lv){ return LESSONS.filter(l => l.level === lv); }
function getLevelDone(lv){ return getLevelLessons(lv).filter(l => isDone(progress, l.id)).length; }
function getDoneCount(){ return LESSONS.filter(l => isDone(progress, l.id)).length; }

function updateStreak(){
  try {
    const today = new Date().toDateString();
    let justHit = null;
    if (!streakData) streakData = { count:1, lastDate:today };
    else if (streakData.lastDate !== today) {
      const yest = new Date(Date.now() - 86400000).toDateString();
      if (streakData.lastDate === yest) {
        streakData.count++;
        const hit = STREAK_BADGES.find(b => b.streak === streakData.count);
        if (hit && !streakToastShown.includes(hit.id)) { streakToastShown.push(hit.id); saveStreakToast(); justHit = hit; }
      } else streakData.count = 1;
      streakData.lastDate = today;
    }
    saveStreak();
    if (justHit) setTimeout(() => showStreakToast(justHit), 800);
  } catch(e) { console.warn('streak fail', e); }
}
function showStreakToast(b){
  try {
    const t = document.createElement('div');
    t.className = 'streak-toast';
    t.innerHTML = `${b.icon} ${b.label}! Стрик: ${b.streak} дней`;
    document.body.appendChild(t);
    requestAnimationFrame(() => t.classList.add('show'));
    setTimeout(() => { t.classList.remove('show'); setTimeout(() => t.remove(), 400); }, 3500);
  } catch(e) {}
}
function getRank(){
  const n = getDoneCount();
  let current = RANKS[0];
  for (const r of RANKS) { if (n >= r.min) current = r; }
  const next = RANKS.find(r => r.min > n) || current;
  const pct = next.nextMin === current.min ? 100 : Math.min(100, ((n - current.min) / (next.nextMin - current.min)) * 100);
  return { current, next, pct, done: n };
}
function getUnlockedBadges(){
  const regular = BADGES.filter(b => { try { return b.check(progress, testResult); } catch { return false; } });
  const streak = STREAK_BADGES.filter(b => streakData && streakData.count >= b.streak);
  return { regular, streak, total: regular.length + streak.length };
}
