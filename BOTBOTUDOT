<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="theme-color" content="#000000">
<title>Pulsar Music | Гид по музыкальной индустрии</title>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;600;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/ru.js"></script>
<style>
:root{--bg:#000;--card:rgba(10,10,10,.75);--border:rgba(255,255,255,.08);--border-strong:rgba(6,182,212,.35);--cyan:#06b6d4;--cyan-glow:rgba(6,182,212,.25);--blue:#3b82f6;--text:#fff;--dim:#888;--dim2:#555;--warn:#f59e0b;--err:#ef4444;--success:#10b981;--r:16px;--green:#10b981;--violet:#8b5cf6}
*{margin:0;padding:0;box-sizing:border-box;font-family:'Montserrat',sans-serif;-webkit-tap-highlight-color:transparent}
html,body{min-height:100vh;min-height:100dvh}
body{background:#000;color:var(--text);overflow-x:hidden;position:relative}
body::before{content:'';position:fixed;inset:0;z-index:0;pointer-events:none;background-image:linear-gradient(rgba(255,255,255,.02) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.02) 1px,transparent 1px);background-size:60px 60px;mask-image:radial-gradient(circle at 50% 30%,#000 20%,transparent 80%);-webkit-mask-image:radial-gradient(circle at 50% 30%,#000 20%,transparent 80%)}
body::after{content:'';position:fixed;inset:0;z-index:0;pointer-events:none;background:radial-gradient(circle at 50% 20%,rgba(6,182,212,.08) 0%,transparent 60%);animation:pulseGlow 4s infinite alternate}
@keyframes pulseGlow{0%{opacity:.4}100%{opacity:.9}}
#app{position:relative;z-index:1;max-width:480px;margin:0 auto;padding:22px 18px 40px;min-height:100vh;min-height:100dvh;isolation:isolate;-webkit-transform:translateZ(0);transform:translateZ(0)}
.screen{animation:in .35s ease}
@keyframes in{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.hero{text-align:center;margin:20px 0 22px}
.hero h1{font-size:26px;font-weight:300;letter-spacing:3px;text-transform:uppercase;margin-bottom:12px;line-height:1.2}
.hero h1 b{font-weight:800;color:var(--cyan);text-shadow:0 0 30px var(--cyan-glow)}
.hero p{color:var(--dim);font-size:13px;letter-spacing:1.5px;text-transform:uppercase}
.label{font-size:11px;text-transform:uppercase;letter-spacing:3px;color:var(--cyan);margin:22px 2px 12px;font-weight:600;display:flex;align-items:center;gap:8px}
.label::before{content:'';width:16px;height:1px;background:var(--cyan);opacity:.5}
.collapse{background:var(--card);border:1px solid var(--border);border-radius:var(--r);margin-bottom:12px;overflow:hidden;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.collapse-header{padding:16px 20px;display:flex;align-items:center;gap:8px;cursor:pointer;font-size:12px;font-weight:600;letter-spacing:2px;text-transform:uppercase;user-select:none;transition:color .2s}
.collapse-header:hover{color:var(--cyan)}
.collapse-header .chev{color:var(--cyan);font-size:10px;transition:transform .3s;margin-left:auto}
.collapse-centered .collapse-header{justify-content:center;text-align:center}
.collapse-centered .collapse-header .chev{margin-left:6px}
.collapse.open .collapse-header .chev{transform:rotate(180deg)}
.collapse-body{max-height:0;overflow:hidden;transition:max-height .4s ease}
.collapse.open .collapse-body{max-height:1400px}
.collapse-body-inner{padding:0 16px 16px}
.level-card{display:flex;align-items:center;gap:14px;padding:18px;background:var(--card);border:1px solid var(--border);border-radius:var(--r);margin-bottom:10px;cursor:pointer;transition:.3s;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);position:relative;overflow:hidden}
.level-card::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--cyan),transparent);opacity:.4}
.level-card:hover{transform:translateY(-3px);border-color:var(--cyan);box-shadow:0 10px 40px var(--cyan-glow)}
.level-card.middle::before{background:linear-gradient(90deg,transparent,var(--green),transparent)}
.level-card.middle:hover{border-color:var(--green);box-shadow:0 10px 40px rgba(16,185,129,.25)}
.level-card.pro::before{background:linear-gradient(90deg,transparent,var(--violet),transparent)}
.level-card.pro:hover{border-color:var(--violet);box-shadow:0 10px 40px rgba(139,92,246,.25)}
.licon{font-size:28px;width:50px;height:50px;display:flex;align-items:center;justify-content:center;background:rgba(6,182,212,.08);border:1px solid rgba(6,182,212,.2);border-radius:14px;flex-shrink:0}
.level-card.middle .licon{background:rgba(16,185,129,.08);border-color:rgba(16,185,129,.2)}
.level-card.pro .licon{background:rgba(139,92,246,.08);border-color:rgba(139,92,246,.2)}
.linfo{flex:1}
.lname{font-size:15px;font-weight:600;margin-bottom:3px;letter-spacing:1px;text-transform:uppercase}
.ldesc{font-size:12px;color:var(--dim);line-height:1.4}
.lprog{font-size:10px;color:var(--cyan);font-weight:600;letter-spacing:1px;margin-top:4px}
.level-card.middle .lprog{color:var(--green)}
.level-card.pro .lprog{color:var(--violet)}
.larr{font-size:20px;color:var(--cyan)}
.level-card.middle .larr{color:var(--green)}
.level-card.pro .larr{color:var(--violet)}
.test-card{display:flex;align-items:center;gap:14px;padding:18px;background:linear-gradient(135deg,rgba(6,182,212,.12),rgba(59,130,246,.06));border:1px solid var(--border-strong);border-radius:var(--r);margin-bottom:12px;cursor:pointer;transition:.3s;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);position:relative;overflow:hidden}
.test-card::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--cyan),transparent)}
.test-card:hover{transform:translateY(-3px);box-shadow:0 10px 40px var(--cyan-glow)}
.test-icon{font-size:26px;width:50px;height:50px;display:flex;align-items:center;justify-content:center;background:rgba(6,182,212,.1);border:1px solid rgba(6,182,212,.25);border-radius:14px;flex-shrink:0;filter:drop-shadow(0 0 10px var(--cyan-glow))}
.test-info{flex:1}
.test-name{font-size:14px;font-weight:700;margin-bottom:3px}
.test-desc{font-size:11.5px;color:var(--dim);line-height:1.4}
.test-badge{padding:5px 11px;background:var(--cyan);color:#000;border-radius:9px;font-size:12px;font-weight:800}
.test-result-line{padding:12px 16px;background:rgba(6,182,212,.06);border:1px solid rgba(6,182,212,.2);border-radius:12px;margin-bottom:12px;font-size:12.5px;text-align:center;color:rgba(255,255,255,.85);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.test-result-line b{color:var(--cyan);font-weight:700}
.topbar{display:flex;align-items:center;gap:10px;margin-bottom:16px}
.back{width:38px;height:38px;border-radius:11px;background:var(--card);border:1px solid var(--border);color:var(--cyan);font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:.2s;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.back:hover{background:rgba(15,15,15,.9);border-color:var(--cyan)}
.topbar h2{font-size:14px;font-weight:600;flex:1;letter-spacing:2px;text-transform:uppercase}
.goal-widget{display:flex;align-items:center;gap:12px;padding:14px 16px;background:var(--card);border:1px solid var(--border);border-radius:14px;margin-bottom:16px;cursor:pointer;transition:.3s;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);position:relative;overflow:hidden}
.goal-widget::before{content:'';position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--cyan);box-shadow:0 0 10px var(--cyan)}
.goal-widget:hover{border-color:var(--cyan);box-shadow:0 0 30px var(--cyan-glow)}
.goal-widget .gi{font-size:20px}
.goal-widget .gt{flex:1}
.goal-widget .gl{font-size:10px;text-transform:uppercase;letter-spacing:2px;color:var(--cyan);font-weight:700;margin-bottom:2px}
.goal-widget .gn{font-size:13px;font-weight:600;color:var(--text)}
.goal-widget .gc{font-size:11px;color:var(--cyan);font-weight:600;letter-spacing:1px;text-transform:uppercase}
.rank-card{padding:18px 20px;background:linear-gradient(135deg,rgba(6,182,212,.08),rgba(59,130,246,.06));border:1px solid var(--border-strong);border-radius:var(--r);margin-bottom:14px;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);position:relative;overflow:hidden}
.rank-card::before{content:'';position:absolute;top:-40px;right:-40px;width:120px;height:120px;background:radial-gradient(circle,var(--cyan),transparent 70%);filter:blur(20px);opacity:.25}
.rank-card .rh{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px;position:relative;z-index:1}
.rank-card .rl{font-size:10px;text-transform:uppercase;letter-spacing:2px;color:var(--dim);font-weight:600}
.rank-card .rv{font-size:13px;color:var(--cyan);font-weight:800;letter-spacing:1px;text-transform:uppercase}
.rank-card .rn{font-size:15px;font-weight:700;letter-spacing:.5px;color:var(--text);margin-bottom:12px;position:relative;z-index:1}
.rank-card .rn span{color:var(--cyan)}
.rank-card .rp{height:5px;background:rgba(255,255,255,.06);border-radius:2px;overflow:hidden;position:relative;z-index:1}
.rank-card .rf{height:100%;background:linear-gradient(90deg,var(--cyan),var(--blue));transition:width .8s ease;box-shadow:0 0 10px var(--cyan)}
.rank-card .next{font-size:11px;color:var(--dim);margin-top:8px;letter-spacing:.5px;position:relative;z-index:1}
.badges-scroll{display:flex;gap:8px;overflow-x:auto;padding:4px 2px 8px;scrollbar-width:none}
.badges-scroll::-webkit-scrollbar{display:none}
.badge{flex-shrink:0;width:76px;text-align:center;padding:10px 6px;background:rgba(15,15,20,.6);border:1px solid var(--border);border-radius:12px;transition:.3s;opacity:.3}
.badge.unlocked{opacity:1;border-color:var(--border-strong);background:linear-gradient(135deg,rgba(6,182,212,.08),rgba(59,130,246,.04));box-shadow:0 0 20px var(--cyan-glow)}
.badge.streak-badge.unlocked{border-color:rgba(245,158,11,.4);box-shadow:0 0 20px rgba(245,158,11,.2)}
.badge.level-badge.middle.unlocked{border-color:rgba(16,185,129,.4);box-shadow:0 0 20px rgba(16,185,129,.2)}
.badge.level-badge.pro.unlocked{border-color:rgba(139,92,246,.4);box-shadow:0 0 20px rgba(139,92,246,.2)}
.badge .bi{font-size:22px;display:block;margin-bottom:4px}
.badge .bn{font-size:9px;font-weight:600;line-height:1.2;color:var(--dim);letter-spacing:.5px;text-transform:uppercase}
.badge.unlocked .bn{color:var(--text)}
.lesson-item{display:flex;align-items:center;gap:12px;padding:16px;background:var(--card);border:1px solid var(--border);border-radius:14px;margin-bottom:8px;cursor:pointer;transition:.3s;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);position:relative;overflow:hidden}
.lesson-item:hover{transform:translateX(4px);border-color:var(--cyan);box-shadow:0 4px 20px var(--cyan-glow)}
.lesson-item.done{border-color:var(--border-strong)}
.lesson-item.done::before{content:'';position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--cyan);box-shadow:0 0 12px var(--cyan)}
.lesson-item.read{border-color:rgba(245,158,11,.4)}
.lesson-item.read::before{content:'';position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--warn)}
.lesson-num{width:34px;height:34px;border-radius:10px;background:rgba(6,182,212,.08);border:1px solid rgba(6,182,212,.25);color:var(--cyan);font-weight:800;font-size:13px;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:.3s;letter-spacing:1px}
.lesson-item.done .lesson-num{background:var(--cyan);color:#000;border-color:var(--cyan);font-size:0}
.lesson-item.done .lesson-num::before{content:'✓';font-size:16px;font-weight:800}
.lesson-item.read .lesson-num{background:rgba(245,158,11,.15);border-color:rgba(245,158,11,.4);color:var(--warn);font-size:0}
.lesson-item.read .lesson-num::before{content:'◐';font-size:15px}
.lesson-goal{position:absolute;top:8px;right:8px;font-size:10px}
.lesson-info{flex:1;min-width:0}
.lesson-title{font-size:13.5px;font-weight:600;margin-bottom:3px}
.lesson-sub{font-size:11px;color:var(--dim);line-height:1.4}
.lesson-item .arrow{color:var(--dim);font-size:16px}
.menu-list{display:flex;flex-direction:column;gap:6px}
.menu-item{display:flex;align-items:center;gap:12px;padding:14px 16px;background:rgba(15,15,20,.5);border:1px solid var(--border);border-radius:12px;cursor:pointer;transition:.3s}
.menu-item:hover{border-color:var(--cyan);transform:translateX(3px);box-shadow:0 4px 20px var(--cyan-glow)}
.menu-item .mi{font-size:18px;width:30px;text-align:center;filter:drop-shadow(0 0 8px var(--cyan-glow))}
.menu-item .mt{flex:1;font-size:13px;font-weight:500}
.menu-item .ma{color:var(--dim);font-size:14px}
.lesson-hero{padding:28px 22px;background:linear-gradient(135deg,rgba(6,182,212,.08),rgba(59,130,246,.06));border:1px solid var(--border-strong);border-radius:var(--r);margin-bottom:22px;position:relative;overflow:hidden}
.lesson-hero.middle{background:linear-gradient(135deg,rgba(16,185,129,.08),rgba(6,182,212,.06));border-color:rgba(16,185,129,.35)}
.lesson-hero.pro{background:linear-gradient(135deg,rgba(139,92,246,.08),rgba(59,130,246,.06));border-color:rgba(139,92,246,.35)}
.lesson-hero::before{content:'';position:absolute;top:0;left:0;right:0;height:1px;background:linear-gradient(90deg,transparent,var(--cyan),transparent)}
.lesson-badge{display:inline-block;font-size:10px;text-transform:uppercase;letter-spacing:2.5px;color:var(--cyan);font-weight:700;margin-bottom:10px}
.lesson-hero.middle .lesson-badge{color:var(--green)}
.lesson-hero.pro .lesson-badge{color:var(--violet)}
.lesson-hero h1{font-size:22px;font-weight:800;line-height:1.25;margin-bottom:6px}
.lesson-hero .ls{color:var(--dim);font-size:12px;letter-spacing:1px;text-transform:uppercase}
.lesson-body p{font-size:14.5px;line-height:1.75;margin-bottom:16px;color:rgba(255,255,255,.88)}
.lesson-body p strong{color:var(--cyan);font-weight:600}
.lesson-body ul{list-style:none;margin:0 0 16px;padding:0}
.lesson-body li{padding:12px 16px;background:var(--card);border:1px solid var(--border);border-radius:12px;margin-bottom:6px;font-size:13.5px;line-height:1.55;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.tip{padding:14px 16px;background:rgba(6,182,212,.06);border-left:2px solid var(--cyan);border-radius:8px;margin-bottom:16px;font-size:13.5px;line-height:1.65;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.tip strong{color:var(--cyan);font-weight:600}
.tip.warn{border-left-color:var(--warn);background:rgba(245,158,11,.06)}
.tip.warn strong{color:var(--warn)}
.expandable{background:var(--card);border:1px solid var(--border);border-radius:12px;margin-bottom:14px;overflow:hidden;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.expandable-head{padding:14px 16px;cursor:pointer;display:flex;justify-content:space-between;align-items:center;font-size:13px;font-weight:600}
.expandable-head .chev{transition:.3s;color:var(--cyan);font-size:10px}
.expandable.open .chev{transform:rotate(180deg)}
.expandable-body{max-height:0;overflow:hidden;transition:max-height .4s}
.expandable.open .expandable-body{max-height:1400px}
.expandable-inner{padding:0 16px 14px;font-size:13px;line-height:1.6}
.expandable-inner ul{margin:0;padding:0;list-style:none}
.expandable-inner li{padding:6px 0;margin:0;background:transparent;border:none;display:block;font-size:13px;border-bottom:1px solid rgba(255,255,255,.03)}
.expandable-inner li:last-child{border-bottom:none}
.expandable-inner li::before{content:'▸';color:var(--cyan);font-weight:700;margin-right:8px}
.options-block{margin-bottom:16px}
.option-btn{display:flex;gap:10px;align-items:center;padding:13px 16px;background:var(--card);border:1px solid var(--border);border-radius:12px;margin-bottom:8px;color:var(--text);font-size:13px;cursor:pointer;transition:.2s;width:100%;text-align:left;font-family:inherit;font-weight:500}
.option-btn:hover{border-color:var(--cyan);background:rgba(6,182,212,.06)}
.option-answer{display:none;padding:14px 16px;background:rgba(6,182,212,.08);border:1px solid rgba(6,182,212,.2);border-radius:10px;font-size:13px;line-height:1.6;margin-bottom:16px;color:rgba(255,255,255,.9)}
.option-answer.show{display:block;animation:in .35s ease}
.term-link{color:var(--cyan);border-bottom:1px dashed rgba(6,182,212,.5);cursor:pointer;font-weight:500}
.lesson-checklist{background:var(--card);border:1px solid var(--border-strong);border-radius:14px;padding:16px;margin:18px 0;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.lc-title{font-size:11px;font-weight:700;margin-bottom:12px;color:var(--cyan);letter-spacing:2px;text-transform:uppercase}
.lc-item{display:flex;align-items:flex-start;gap:10px;padding:8px 0;font-size:13px;line-height:1.5;cursor:pointer;color:rgba(255,255,255,.9);border-bottom:1px solid rgba(255,255,255,.03)}
.lc-item:last-child{border-bottom:none}
.lc-item input{accent-color:var(--cyan);width:16px;height:16px;margin-top:2px;flex-shrink:0;cursor:pointer}
.lc-item.done{color:var(--dim);text-decoration:line-through}
.nav-buttons{display:flex;gap:10px;margin-top:24px}
.btn-primary,.btn-secondary{flex:1;padding:16px;border-radius:12px;font-size:13px;font-weight:700;cursor:pointer;border:none;transition:.3s;font-family:inherit;letter-spacing:1.5px;text-transform:uppercase}
.btn-primary{background:linear-gradient(135deg,var(--cyan),var(--blue));color:#000;box-shadow:0 4px 24px var(--cyan-glow);font-weight:800}
.btn-primary:hover{transform:translateY(-2px);box-shadow:0 8px 32px var(--cyan-glow)}
.btn-secondary{background:var(--card);border:1px solid var(--border);color:var(--text);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.btn-secondary:hover{background:rgba(15,15,15,.9);border-color:var(--cyan)}
.quiz-progress{display:flex;gap:6px;margin-bottom:22px}
.quiz-dot{flex:1;height:3px;border-radius:2px;background:rgba(255,255,255,.08);transition:.3s}
.quiz-dot.active{background:var(--cyan);box-shadow:0 0 10px var(--cyan)}
.quiz-dot.done{background:var(--blue)}
.test-progress-bar{height:4px;background:rgba(255,255,255,.08);border-radius:2px;overflow:hidden;margin-bottom:22px}
.test-progress-fill{height:100%;background:linear-gradient(90deg,var(--cyan),var(--blue));transition:width .3s;box-shadow:0 0 10px var(--cyan)}
.quiz-q{font-size:17px;font-weight:700;line-height:1.45;margin-bottom:24px}
.quiz-opt{display:flex;align-items:center;gap:12px;padding:16px;background:var(--card);border:1px solid var(--border);border-radius:12px;margin-bottom:10px;color:var(--text);font-size:13.5px;cursor:pointer;transition:.2s;width:100%;text-align:left;font-family:inherit;line-height:1.5;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.quiz-opt:hover:not(.correct):not(.wrong):not(.disabled){border-color:var(--cyan);background:rgba(6,182,212,.06);transform:translateX(3px)}
.quiz-opt.disabled{opacity:.4;cursor:default}
.quiz-opt.correct{border-color:var(--success);background:rgba(16,185,129,.1);box-shadow:0 0 20px rgba(16,185,129,.2)}
.quiz-opt.wrong{border-color:var(--err);background:rgba(239,68,68,.1);animation:shake .4s ease}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
.quiz-opt .letter{width:26px;height:26px;border-radius:8px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;flex-shrink:0}
.quiz-opt.correct .letter{background:var(--success);color:#000;border-color:var(--success)}
.quiz-opt.wrong .letter{background:var(--err);color:#fff;border-color:var(--err)}
.quiz-hint{margin-top:14px;padding:16px;border-radius:12px;font-size:13px;line-height:1.6;display:none;border:1px solid}
.quiz-hint.show{display:block;animation:in .3s ease}
.quiz-hint.error{background:rgba(239,68,68,.08);border-color:rgba(239,68,68,.25);color:#fca5a5}
.quiz-hint.success{background:rgba(16,185,129,.08);border-color:rgba(16,185,129,.25);color:#6ee7b7}
.quiz-hint strong{display:block;margin-bottom:6px;font-size:13px;letter-spacing:1px;text-transform:uppercase}
.complete-card{text-align:center;padding:36px 22px;background:linear-gradient(135deg,rgba(6,182,212,.1),rgba(59,130,246,.08));border:1px solid var(--border-strong);border-radius:var(--r);margin-bottom:16px}
