.calc-result{padding:18px 20px;background:var(--card);border:1px solid var(--border);border-radius:var(--r);margin-bottom:12px;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.calc-result.gross{border-left:2px solid var(--dim2)}
.calc-result.net{background:linear-gradient(135deg,rgba(6,182,212,.08),rgba(59,130,246,.06));border-color:var(--border-strong)}
.calc-result .hdr{font-size:10.5px;text-transform:uppercase;letter-spacing:2px;font-weight:600;margin-bottom:14px;color:var(--dim)}
.calc-result.net .hdr{color:var(--cyan)}
.calc-row{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px}
.calc-row:last-child{margin-bottom:0}
.calc-row .k{font-size:12px;color:var(--dim)}
.calc-row .v{font-size:18px;font-weight:800;color:var(--text)}
.calc-result.net .v{color:var(--cyan);text-shadow:0 0 20px var(--cyan-glow)}
.calc-note{font-size:11px;color:var(--dim2);text-align:center;line-height:1.55;margin-top:10px;padding:0 10px;font-style:italic}
.sim-intro{padding:16px 18px;background:var(--card);border:1px solid var(--border);border-radius:12px;margin-bottom:14px;font-size:13px;line-height:1.65;color:rgba(255,255,255,.85);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.sim-card{padding:16px 18px;background:var(--card);border:1px solid var(--border);border-radius:14px;margin-bottom:10px;cursor:pointer;transition:.3s;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.sim-card:hover{border-color:var(--cyan);transform:translateX(3px)}
.sim-card.chosen{border-color:var(--cyan);background:rgba(6,182,212,.08);box-shadow:0 0 20px var(--cyan-glow)}
.sim-card .sname{font-size:14px;font-weight:700;margin-bottom:10px;display:flex;align-items:center;gap:8px}
.sim-card .terms{font-size:12px;color:var(--dim);line-height:1.7}
