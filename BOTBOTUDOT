const TEST_QUESTIONS = (()=>{
  return TEST_RAW.map(q => {
    const opts = q.o.map(o => ({text:o.t, correct:!!o.c, why:o.w||''}));
    for (let i = opts.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [opts[i], opts[j]] = [opts[j], opts[i]];
    }
    return {q:q.q, opts, correct:opts.findIndex(o=>o.correct), whyCorrect:q.w, lessonTitle:q.l};
  });
})();

function getDiscount(score,total){
  if (total === 0) return {pct:0, label:'', color:'dim'};
  const ratio = score/total;
  if (ratio >= 0.99) return {pct:15, label:'Отлично! Ты знаешь индустрию', color:'cyan'};
  if (ratio >= 0.5) return {pct:7, label:'Хорошо, но есть что подтянуть', color:'cyan'};
  return {pct:3, label:'Начало положено', color:'dim'};
}

