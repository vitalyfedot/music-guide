function isStepComplete(n) {
  const d = state.distribution;
  if (n === 1) return isDistStep1Complete();
  if (n === 2) return isDistStep2Complete();
  if (n === 3 && d.isPro) return isDistStep3Complete();
  if (n === 4 && d.isPro) return isDistStep4Complete();
  return false;
}
function isDistStep1Complete() {
  const d = state.distribution;
  if (!d.artist.trim() || !d.track.trim()) return false;
  if (d.dateStatus !== 'green') return false;
  if (!d.isPro) return isValidEmail(d.email);
  if (!d.releaseType || !d.genre.trim()) return false;
  if (!d.isInstrumental && !d.vocalLang) return false;
  if (d.isFeat && !d.featArtists.trim()) return false;
  return true;
}
function isDistStep2Complete() {
  const d = state.distribution;
  if (!d.authorText.trim() || !d.authorMusic.trim()) return false;
  if (!d.isPro) return isValidUrl(d.socials) && d.rightsText && d.rightsMusic && d.agreeDist;
  return !!d.producer.trim() && !!d.soundEngineer.trim();
}
function isDistStep3Complete() {
  const d = state.distribution;
  if (!d.isPro || !d.socialRows.length) return false;
  return d.socialRows.every(r => isValidUrl(r.url));
}
function isDistStep4Complete() {
  const d = state.distribution;
  if (!d.isPro) return false;
  return !!d.pitching.trim() && d.rightsText && d.rightsMusic && d.agreeDist;
}

