.sim-card .terms span{color:var(--text);font-weight:600}
.sim-result{padding:16px 18px;border-radius:12px;font-size:13px;line-height:1.65;margin-top:12px;border:1px solid}
.sim-result.good{background:rgba(16,185,129,.08);border-color:rgba(16,185,129,.3)}
.sim-result.bad{background:rgba(239,68,68,.08);border-color:rgba(239,68,68,.3)}
.sim-result.mid{background:rgba(245,158,11,.08);border-color:rgba(245,158,11,.3)}
.sim-result strong{display:block;margin-bottom:6px;font-size:13px;letter-spacing:1px;text-transform:uppercase}
.sim-actions{display:flex;gap:8px;margin-top:12px}
.sim-actions button{flex:1;padding:12px;background:var(--card);border:1px solid var(--border);border-radius:10px;color:var(--text);font-size:12px;font-weight:600;cursor:pointer;font-family:inherit;transition:.2s}
.sim-actions button:hover{border-color:var(--cyan);background:rgba(6,182,212,.06)}
.check-card{padding:16px 18px;background:var(--card);border:1px solid var(--border);border-radius:14px;margin-bottom:10px;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.check-card h3{font-size:13px;font-weight:700;margin-bottom:14px;letter-spacing:1.5px;text-transform:uppercase;color:var(--cyan)}
.check-item{display:flex;align-items:flex-start;gap:10px;padding:8px 0;font-size:13px;line-height:1.55;cursor:pointer;color:rgba(255,255,255,.88);border-bottom:1px solid rgba(255,255,255,.03)}
.check-item:last-child{border-bottom:none}
.check-item input{accent-color:var(--cyan);width:16px;height:16px;margin-top:2px;flex-shrink:0;cursor:pointer}
.check-item.done{color:var(--dim);text-decoration:line-through}
.mist-card{padding:16px 18px;background:var(--card);border:1px solid var(--border);border-radius:14px;margin-bottom:10px;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.mist-card h3{font-size:12px;font-weight:700;margin-bottom:12px;color:var(--warn);letter-spacing:1.5px;text-transform:uppercase}
